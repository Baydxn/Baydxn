# ============================================================================
#  BAYD XN — CONTACT FORM DELIVERY
# ============================================================================
#  Copy this file to `.env` and fill in ONE of the blocks below.
#  `.env` is git-ignored, so your keys never reach GitHub.
#
#  The contact form auto-detects which provider to use, in this order:
#    1. Web3Forms   (VITE_WEB3FORMS_ACCESS_KEY)
#    2. EmailJS     (VITE_EMAILJS_* trio)
#    3. Custom API  (VITE_CONTACT_API_URL)
#
#  If none are set, the form still works — it formats the brief and hands it
#  to WhatsApp instead of silently failing.
# ============================================================================

# ---------------------------------------------------------------------------
# OPTION 1 — Web3Forms  (RECOMMENDED: free, unlimited, no account needed)
# ---------------------------------------------------------------------------
# 1. Go to https://web3forms.com
# 2. Enter your inbox: cc99187197@gmail.com
# 3. Copy the Access Key they email you and paste it below
# 4. Restart the dev server (or redeploy)
#
# The inbox is bound to the key itself, so no email address lives in this code.
VITE_WEB3FORMS_ACCESS_KEY=

# ---------------------------------------------------------------------------
# OPTION 2 — EmailJS  (free tier: 200 emails/month)
# ---------------------------------------------------------------------------
# 1. Create an account at https://emailjs.com
# 2. Add an email service (connect your Gmail)
# 3. Create a template using these variables:
#      {{to_email}} {{from_name}} {{reply_to}} {{subject}}
#      {{company}} {{project_type}} {{budget_range}} {{message}}
# 4. Copy the Service ID, Template ID and Public Key below
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# OPTION 3 — Custom endpoint (Vercel Function — see api/contact.ts)
# ---------------------------------------------------------------------------
# Requires server-only variables in the Vercel dashboard (no VITE_ prefix):
#   RESEND_API_KEY       https://resend.com/api-keys
#   CONTACT_TO_EMAIL     cc99187197@gmail.com
#   CONTACT_FROM_EMAIL   onboarding@resend.dev  (until you verify a domain)
VITE_CONTACT_API_URL=

# ---------------------------------------------------------------------------
# OPTIONAL — override the destination inbox shown to the mailer
# ---------------------------------------------------------------------------
# Leave blank to use the default configured in src/data/siteConfig.ts
VITE_CONTACT_INBOX=
